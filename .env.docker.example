# Docker environment variables for UNILIS.
#
# Copy to .env in this directory (compose reads it automatically) and set the
# values you want to override. .env is gitignored — never commit it.
#
#   cp .env.docker.example .env && nano .env
#
# Required values must be supplied before production deployment. The Compose
# file deliberately has no password defaults, so an incomplete .env fails fast.

APP_ENV=production
# Used by CI/CD for immutable per-commit image tags. Leave at defaults for
# local development.
# DOCKER_USERNAME=hilkim21
# IMAGE_TAG=latest
MYSQL_ROOT_PASSWORD=Man-18hattan
MYSQL_PASSWORD=Man-18hattan
SMARTLAB_MYSQL_PASSWORD=Man-18hattan
MEETING_API_KEY=
MEETING_ALLOWED_ORIGINS=https://your-domain.example

# The app is served through Apache on port 8080 by the root Compose stack.
# Use your public HTTPS URL in production; the meeting paths are reverse-proxied
# through Apache, so do not expose port 8765 publicly.
MEETING_PYTHON_APP_URL=https://your-domain.example
MEETING_MEDIA_WS_URL=wss://your-domain.example/ws/media

# --- Meeting Python media server ---

# Shared secret for the read-only /api/meetings/* routes (attendance, chat,
# polls, whiteboard). Callers must send it as an X-API-Key header. Leave unset
# and those routes stay open, which is the previous behaviour. The browser never
# calls them — the meeting frontend is WebSocket-only — so setting this does not
# affect the UI.
# MEETING_API_KEY=

# CORS allowlist, comma-separated. Use explicit HTTPS origins; wildcard origins
# are intentionally not accepted by the production Compose configuration.

# Port exposed on the host (must match docker-compose meeting-server ports)
MEETING_MEDIA_PORT=8765

# Full WebSocket URL for browsers. Leave unset to auto-detect from HTTP_HOST.
# Local Docker: ws://localhost:8765/ws/media (auto-detected)
# Production HTTPS example:
# MEETING_MEDIA_WS_URL=wss://your-domain.com:8765/ws/media

# --- Databases ---
#
# MySQL only reads these while initialising an empty data directory. To rotate
# a live credential, ALTER USER in the database first, then update this file.

# --- App database host (compose service names) ---
# DB_HOST=db
# SMARTLAB_DB_HOST=smart-labs-db
# MYSQL_USER=unilisuser
# MYSQL_DATABASE=unilis

# --- Short-course M-Pesa (Daraja) ---
# Use production only after Safaricom has approved the app and callback URLs.
# MPESA_ENVIRONMENT=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_STK_RESULT_URL=https://your-domain.example/api/mpesa_callback.php
# MPESA_STK_TIMEOUT_URL=https://your-domain.example/api/mpesa_callback.php
#
# B2B uses the central sender shortcode and its own Daraja app/credentials when
# required by the provider. The receiver is each department's Till or PayBill.
# MPESA_B2B_CONSUMER_KEY=
# MPESA_B2B_CONSUMER_SECRET=
# MPESA_B2B_SHORTCODE=
# MPESA_B2B_INITIATOR_NAME=
# MPESA_B2B_SECURITY_CREDENTIAL=
# MPESA_B2B_RESULT_URL=https://your-domain.example/api/mpesa_b2b_callback.php
# MPESA_B2B_TIMEOUT_URL=https://your-domain.example/api/mpesa_b2b_callback.php
