# Docker environment variables for UNILIS (optional overrides)
# Copy to .env and adjust for your deployment.

# --- Meeting Python media server (camera / screen-share rendering) ---
# Port exposed on the host (must match docker-compose meeting-server ports)
MEETING_MEDIA_PORT=8765

# Full WebSocket URL for browsers. Leave unset to auto-detect from HTTP_HOST.
# Local Docker: ws://localhost:8765/ws/media (auto-detected)
# Production HTTPS example:
# MEETING_MEDIA_WS_URL=wss://your-domain.com:8765/ws/media

# --- App database (defaults are set in docker-compose.yml) ---
# DB_HOST=db
# MYSQL_USER=unilisuser
# MYSQL_PASSWORD=unilispass
# MYSQL_DATABASE=unilis
