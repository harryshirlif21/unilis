.env
.env.production
*.pem
*.key
secretkey
node_modules
vendor/
/vendor/
/node_modules/
.env
smart-lab/web-app/logs/*.log
__pycache__/
*.pyc

# No SQL in the repository. The document root is the deployed checkout, so
# anything committed here is a candidate for being served; a 390KB dump of 60
# tables was downloadable this way. Keep schema and backups out of git.
*.sql
*.bak

# Uploaded files - stored in persistent Docker volume on server
uploads/**/*
!uploads/**/.gitkeep

# Local-only DevContainers/Compose override (bind-mounts repo for hot-reload).
# Do NOT deploy to production - production must use the baked image.
docker-compose.override.yml
compose.override.yml

