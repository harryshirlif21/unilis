# Smart Lab Sensor Server Configuration
# Copy this to your production server and customize values

# SERIAL PORT CONFIGURATION
# Windows: COM1, COM2, COM3, COM7, etc.
# Linux: /dev/ttyUSB0, /dev/ttyACM0, /dev/ttyS0, etc.
SMART_LAB_SERIAL_PORT=/dev/ttyUSB0

# Baud rate (standard values: 9600, 19200, 38400, 57600, 115200)
SMART_LAB_BAUD_RATE=9600

# HTTP SERVER CONFIGURATION
# Port where sensor server listens (e.g., 8765)
SMART_LAB_HTTP_PORT=8765

# PUBLIC / PROXIED SENSOR URL
# Use this when the web app reaches the sensor server through a proxy, tunnel, or another host
SMART_LAB_SENSOR_URL=http://localhost:8765

# DATABASE CONFIGURATION
# Production database host (use internal IP or localhost if on same machine)
SMART_LAB_DB_HOST=localhost

# Database user (create dedicated user for security)
SMART_LAB_DB_USER=smart_lab_user

# Database password (use strong password in production)
SMART_LAB_DB_PASS=change_me_to_strong_password

# Database name
SMART_LAB_DB_NAME=unilis_smart_lab

# LOGGING CONFIGURATION
# Log file directory (must be writable by the sensor server process)
SMART_LAB_LOG_PATH=/var/log/smart-lab

# CO2 JSON STORAGE CONFIGURATION
# Directory where daily CO2 JSON files are stored
# Must be writable by the sensor server process
SMART_LAB_JSON_PATH=/var/www/unilis/smart-lab/web-app/co2_data

# SECURITY (Optional: Add authentication token for API endpoints)
# SMART_LAB_API_TOKEN=your_secret_token_here
