{
    "name": "unilis/unilis-app",
    "description": "UNILIS - Learning Management System",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "phpmailer/phpmailer": "^6.8",
        "dompdf/dompdf": "^3.1",
        "chillerlan/php-qrcode": "^6.0",
        "tecnickcom/tcpdf": "^6.11"
    },
    "autoload": {
        "psr-4": {
            "Unilis\\": "src/"
        },
        "files": [
            "vendor/autoload.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
